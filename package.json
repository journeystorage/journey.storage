{
  "name": "journey-storage",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@journey/web",
    "dev:consulting": "turbo dev --filter=@journey/consulting",
    "dev:investors": "turbo dev --filter=@journey/investors",
    "build": "npm run build -w @journey/web",
    "build:web": "npm run build -w @journey/web",
    "build:consulting": "npm run build -w @journey/consulting",
    "start": "npm run start -w @journey/web",
    "start:web": "npm run start -w @journey/web",
    "start:consulting": "npm run start -w @journey/consulting",
    "lint": "turbo lint"
  },
  "dependencies": {
    "next": "^16.2.1"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
