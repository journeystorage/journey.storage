# Journey Hub — Environment Variables
# Copy this file to .env.local and fill in ANTHROPIC_API_KEY.
# Supabase values below are the project's public anon key + URL (same
# project as apps/portal) — safe defaults, only override if the project moves.

NEXT_PUBLIC_SUPABASE_URL=https://uwncchrmdotateyditjc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_1gqMsbBcN6naNPtwlOD_VQ_04C_kizW

# Get a key at https://console.anthropic.com/settings/keys — required, no default.
ANTHROPIC_API_KEY=

# Google (Gmail + Calendar, read-only) — optional. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type: Web application),
# add http://localhost:3006/api/google/callback as an authorized redirect URI,
# and enable the Gmail API + Google Calendar API for the project. Then run
# supabase/hub_google.sql in the Supabase SQL editor and click Connect on /connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only set this if the hub runs somewhere other than localhost:3006.
# GOOGLE_REDIRECT_URI=http://localhost:3006/api/google/callback
