# ─────────────────────────────────────────────────────────────
#  JOURNEY.STORAGE PORTAL — headers & caching (LiteSpeed/Apache)
# ─────────────────────────────────────────────────────────────

<IfModule mod_headers.c>
  # ── Security headers (enforced; safe for a non-embedded portal) ──
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # ── CSP in Report-Only first (won't break anything; watch the console,
  #    then promote to "Content-Security-Policy" once it's clean) ──
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://journey.storage https://uwncchrmdotateyditjc.supabase.co; connect-src 'self' https://uwncchrmdotateyditjc.supabase.co wss://uwncchrmdotateyditjc.supabase.co https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; worker-src 'self' blob: https://cdnjs.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  # ── Caching ──
  # App shell + config always revalidated, so edits go live immediately
  # (this is why the config.js cache-buster is no longer needed).
  <FilesMatch "(index\.html|config\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Fonts are content-stable — cache hard for a year.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
