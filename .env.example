# Journey.Storage — Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase (lead capture writes to public.leads)
# Get these from Supabase Studio → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (emails a notification to the team on each Contact Us submission)
# Get an API key at https://resend.com → API Keys
RESEND_API_KEY=
# Optional overrides:
#   LEAD_NOTIFY_TO   – who receives the email (default: lyvia@journey.storage)
#   LEAD_NOTIFY_FROM – sender (default: onboarding@resend.dev until journey.storage
#                      is verified in Resend, then e.g. "Journey.Storage <notify@journey.storage>")
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=

# Google Maps (reserved — not currently used in code)
GOOGLE_MAPS_API_KEY=

# Tenant Inc. / Nectar API (Hummingbird PMS) — used by tenant-lab only
TENANT_API_BASE_URL=https://prod.edge.tenant.dev/api/v3/applications
TENANT_APP_ID=
TENANT_COMPANY_ID=
TENANT_API_KEY=
TENANT_API_VERSION=v2

# ─── Nectar / Tenant Inc. (rentaspace online rental) — server-side only ───
NECTAR_BASE_URL=https://edge.tenant.dev/api/v3
NECTAR_API_KEY=

# GDS owner id (own...) for Journey.Storage — used for customer lookup.
NECTAR_OWNER_ID=

# GDS facility ids (fac...) for the three Granbury locations.
FACILITY_TEMPLEHALL_ID=
FACILITY_WESTERNHILLS_ID=
FACILITY_MCCREARY_ID=

# Hummingbird passthrough (move-out flow only).
# HB_APPLICATION_ID defaults to the production Hummingbird app id from the docs.
HB_APPLICATION_ID=appbc35600a675841eea5893df84231789e
HB_COMPANY_ID=

# Dev convenience: allow account lookup without OTP verification (never in prod).
ACCOUNT_LOOKUP_OPEN=false
